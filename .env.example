# Copia este archivo a .env.local y completa los valores. NO subas .env.local.

# --- Appwrite (valores públicos del proyecto; ya los usa el Sprint 1) ---
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=tu_project_id

# --- IDs de las DOS Appwrite Functions (no son secretos): create-order y update-order-status.
#     update-order-status tambien atiende panel de personal, repartidor y ubicacion. Si se dejan vacíos la app
#     escribe directo en TablesDB: SOLO para desarrollo, sin validación de servidor. ---
EXPO_PUBLIC_FN_CREATE_ORDER=
EXPO_PUBLIC_FN_UPDATE_ORDER_STATUS=

# Opcional: dibuja la ruta real en el seguimiento (Google Directions API; clave restringida).
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=

# --- Pago en linea (Mercado Pago Checkout Pro). Solo se ofrece con "true" Y las 2 Functions configuradas.
#     Las credenciales (MP_ACCESS_TOKEN) viven SOLO en las variables de la Function create-order /
#     update-order-status, nunca aqui. Usa credenciales de PRUEBA.
EXPO_PUBLIC_ENABLE_ONLINE_PAYMENT=false

# --- Recuperacion de contrasena: URL https donde publicaste recovery-bridge/index.html.
#     Su hostname debe estar en Appwrite > Overview > Platforms (Web).
EXPO_PUBLIC_RECOVERY_URL=https://tu-usuario.github.io/tu-repo/


# --- Google Maps SDK for Android (se lee en la compilación vía app.config.js).
#     Sin prefijo EXPO_PUBLIC_. Restringe la clave por paquete + SHA-1. ---
GOOGLE_MAPS_ANDROID_API_KEY=REEMPLAZA_CON_TU_CLAVE
