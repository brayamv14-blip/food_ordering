# Copia este archivo a .env.local y completa los valores. NO subas .env.local.
# Todo lo que empieza con EXPO_PUBLIC_ viaja DENTRO de la app: nunca pongas ahi claves secretas.

# --- Appwrite (valores públicos del proyecto) ---
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=tu_project_id

# --- IDs de las Appwrite Functions (no son secretos): create-order y update-order-status.
#     (stripe-webhook no se llama desde la app: la invoca Stripe.) ---
EXPO_PUBLIC_FN_CREATE_ORDER=
EXPO_PUBLIC_FN_UPDATE_ORDER_STATUS=

# --- Mapas, direcciones y rutas: Geoapify (clave PÚBLICA; restríngela por app/dominio en el panel de Geoapify) ---
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# --- Pago en línea con Stripe Checkout. Solo se ofrece con "true" Y las Functions configuradas.
#     La clave secreta (STRIPE_SECRET_KEY) y el secreto del webhook (STRIPE_WEBHOOK_SECRET) viven SOLO
#     en las variables de las Functions de Appwrite (ver docs/STRIPE.md), JAMÁS aqui. Usa claves de PRUEBA (sk_test_). ---
EXPO_PUBLIC_ENABLE_ONLINE_PAYMENT=false

# --- Notificaciones push: ID del proveedor FCM creado en Appwrite > Messaging > Providers (no es secreto) ---
EXPO_PUBLIC_APPWRITE_PUSH_PROVIDER_ID=

# --- Recuperación de contraseña: URL https donde publicaste recovery-bridge/index.html.
#     Su hostname debe estar en Appwrite > Overview > Platforms (Web). ---
EXPO_PUBLIC_RECOVERY_URL=https://tu-usuario.github.io/tu-repo/

# --- Restaurante (opcional): si se definen, el seguimiento muestra su marcador y el repartidor puede navegar a él.
#     No se inventa ninguna ubicación: sin estas variables no aparece. ---
EXPO_PUBLIC_RESTAURANT_LATITUDE=
EXPO_PUBLIC_RESTAURANT_LONGITUDE=
EXPO_PUBLIC_RESTAURANT_NAME=
